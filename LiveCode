// ── HEAT HELPERS ──────────────────────────────────────────────────────────────
function heatColor(h) {
  if (h >= 81) return { bg:'#FF2442', glow:'rgba(255,36,66,0.7)',  label:'Packed',   emoji:'🔥' };
  if (h >= 61) return { bg:'#FF8C00', glow:'rgba(255,140,0,0.6)',  label:'Busy',     emoji:'⚡' };
  if (h >= 41) return { bg:'#FFD700', glow:'rgba(255,215,0,0.5)',  label:'Moderate', emoji:'🙂' };
  if (h >= 21) return { bg:'#00C896', glow:'rgba(0,200,150,0.4)',  label:'Chill',    emoji:'😌' };
  return             { bg:'#3B4A6B', glow:'rgba(59,74,107,0.3)',   label:'Dead',     emoji:'💤' };
}

function pinSVG(v) {
  const c = heatColor(v.heat);
  const sz = Math.max(30, Math.min(50, 22 + v.heat * 0.27));
  const ring = v.heat > 65
    ? `<circle cx="${(sz+18)/2}" cy="${(sz+18)/2}" r="${sz/2+7}" fill="${c.bg}20" stroke="${c.bg}55" stroke-width="1.5"/>`
    : '';
  const star = v.promoted
    ? `<circle cx="${sz+14}" cy="4" r="7" fill="#FFD700"/><text x="${sz+14}" y="8" text-anchor="middle" font-size="9" fill="#000">★</text>`
    : '';
  const em = EMOJIS[v.type] || '📍';
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${sz+18}" height="${sz+18}">
    <defs>
      <filter id="f${v.id}"><feGaussianBlur stdDeviation="2.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <radialGradient id="g${v.id}" cx="38%" cy="33%">
        <stop offset="0%" stop-color="${c.bg}"/>
        <stop offset="100%" stop-color="${c.bg}88"/>
      </radialGradient>
    </defs>
    ${ring}
    <circle cx="${(sz+18)/2}" cy="${(sz+18)/2}" r="${sz/2}" fill="url(#g${v.id})" stroke="${selectedId===v.id?'#fff':c.bg}" stroke-width="${selectedId===v.id?2.5:1.5}" filter="url(#f${v.id})"/>
    <text x="${(sz+18)/2}" y="${(sz+18)/2+6}" text-anchor="middle" font-size="${Math.round(sz*0.43)}">${em}</text>
    ${star}
  </svg>`;
}

// ── INIT ──────────────────────────────────────────────────────────────────────
async function init() {
  await loadVenues();
  initMap();
  subscribeRealtime();
  setInterval(refreshVenues, 15000); // re-fetch every 15s
  document.getElementById('loading').style.display = 'none';
  document.getElementById('app').style.display = 'flex';
}

async function loadVenues() {
  if (!sb) {
    console.warn('No Supabase — using built-in Orlando venues');
    venues = FALLBACK_VENUES;
    updateHeaderStats();
    return;
  }
  try {
    const { data, error } = await sb.from('venues').select('*').order('heat', { ascending: false });
    if (data && data.length > 0) {
      venues = data;
    } else {
      console.warn('No data from Supabase, using fallback. Error:', error);
      venues = FALLBACK_VENUES;
    }
  } catch(e) {
    console.warn('Supabase fetch failed, using fallback:', e);
    venues = FALLBACK_VENUES;
  }
  updateHeaderStats();
}

async function refreshVenues() {
  if (!sb) return;
  try {
    const { data } = await sb.from('venues').select('*').order('heat', { ascending: false });
    if (data && data.length > 0) {
      venues = data;
      updateHeaderStats();
      updateMarkers();
      if (activeTab === 'list') renderList();
      if (activeTab === 'trending') renderTrending();
    }
  } catch(e) { console.warn('Refresh failed:', e); }
}

function updateHeaderStats() {
  const total = venues.reduce((s, v) => s + (v.checkin_count || 0), 0);
  document.getElementById('people-count').textContent = total.toLocaleString() + ' people tracked tonight';
  document.getElementById('hot-count').textContent = venues.filter(v => v.heat > 70).length;
}

// ── REALTIME ──────────────────────────────────────────────────────────────────
function subscribeRealtime() {
  if (!sb) return;
  try {
    sb.channel('venues-live')
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'venues' }, payload => {
        const idx = venues.findIndex(v => v.id === payload.new.id);
        if (idx >= 0) venues[idx] = payload.new;
        else venues.push(payload.new);
        updateMarkers();
        updateHeaderStats();
        if (activeTab === 'list') renderList();
        if (activeTab === 'trending') renderTrending();
      })
      .subscribe();
  } catch(e) { console.warn('Realtime subscribe failed:', e); }
}

// ── GOOGLE MAP ────────────────────────────────────────────────────────────────
function initMap() {
  const initFn = () => {
    gmap = new google.maps.Map(document.getElementById('gmap'), {
      center: { lat: 28.5383, lng: -81.3792 },
      zoom: 13,
      disableDefaultUI: true,
      styles: [
        { elementType:'geometry', stylers:[{ color:'#070b14' }] },
        { elementType:'labels.text.fill', stylers:[{ color:'#475569' }] },
        { elementType:'labels.text.stroke', stylers:[{ color:'#070b14' }] },
        { featureType:'road', elementType:'geometry', stylers:[{ color:'#0f172a' }] },
        { featureType:'road', elementType:'geometry.stroke', stylers:[{ color:'#1e293b' }] },
        { featureType:'road.highway', elementType:'geometry', stylers:[{ color:'#1e293b' }] },
        { featureType:'water', elementType:'geometry', stylers:[{ color:'#04070e' }] },
        { featureType:'poi', elementType:'geometry', stylers:[{ color:'#0a0f1e' }] },
        { featureType:'landscape', elementType:'geometry', stylers:[{ color:'#080c18' }] },
      ],
    });
    updateMarkers();
  };
  if (window._mapReady) initFn();
  else window._mapReadyCb = initFn;
}

function filteredVenues() {
  return activeFilter === 'All' ? venues : venues.filter(v => v.type === activeFilter);
}

function updateMarkers() {
  if (!gmap) return;
  // clear old markers
  Object.values(markers).forEach(m => m.setMap(null));
  markers = {};

  const shown = filteredVenues();

  shown.forEach(v => {
    const c = heatColor(v.heat);
    const sz = Math.max(30, Math.min(50, 22 + v.heat * 0.27));
    const svg = pinSVG(v);
    const marker = new google.maps.Marker({
      position: { lat: v.lat, lng: v.lng },
      map: gmap,
      icon: {
        url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg),
        anchor: new google.maps.Point((sz+18)/2, (sz+18)/2),
      },
      title: v.name,
      zIndex: v.heat,
    });
    marker.addListener('click', () => openSheet(v.id));
    markers[v.id] = marker;
  });

  // Heatmap overlay
  if (google.maps.visualization) {
    if (heatLayer) heatLayer.setMap(null);
    heatLayer = new google.maps.visualization.HeatmapLayer({
      data: shown.filter(v => v.heat > 40).map(v => ({
        location: new google.maps.LatLng(v.lat, v.lng),
        weight: v.heat / 100,
      })),
      map: gmap,
      radius: 60, opacity: 0.35,
      gradient: ['transparent','rgba(0,200,150,0.3)','rgba(255,215,0,0.5)','rgba(255,140,0,0.65)','rgba(255,36,66,0.85)'],
    });
  }
}

