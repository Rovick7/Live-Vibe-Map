<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@700&display=swap');

:root {
  --red:    #FF2442;
  --orange: #FF8C00;
  --yellow: #FFD700;
  --green:  #00C896;
  --dark:   #070b14;
  --card:   #0d1429;
  --border: #1e293b;
  --muted:  #64748b;
  --text:   #f1f5f9;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; background: var(--dark); overflow: hidden; }
body { font-family: 'Syne', sans-serif; color: var(--text); }

#app { max-width: 430px; margin: 0 auto; height: 100vh; display: flex; flex-direction: column; position: relative; overflow: hidden; }

/* ── Scrollable panels ── */
.panel { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.panel::-webkit-scrollbar { width: 0; }

/* ── Header ── */
#header { padding: 48px 20px 14px; background: linear-gradient(180deg, rgba(7,11,20,1) 60%, transparent); flex-shrink: 0; position: relative; z-index: 10; }
.header-row { display: flex; justify-content: space-between; align-items: flex-start; }
.live-badge { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); animation: blink 1.5s ease-in-out infinite; }
.live-label { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--red); font-family: 'Space Mono', monospace; }
.app-title { font-size: 27px; font-weight: 800; letter-spacing: -.03em; line-height: 1; }
.people-count { font-size: 11px; color: var(--muted); margin-top: 3px; font-family: 'Space Mono', monospace; }
.hot-badge { background: rgba(255,36,66,.1); border: 1px solid rgba(255,36,66,.3); border-radius: 12px; padding: 8px 13px; text-align: center; }
.hot-num { font-size: 22px; font-weight: 800; color: var(--red); font-family: 'Space Mono', monospace; }
.hot-lbl { font-size: 9px; color: var(--red); letter-spacing: .1em; font-family: 'Space Mono', monospace; }

/* ── Tabs ── */
#tabs { display: flex; border-bottom: 1px solid #0f172a; background: var(--dark); flex-shrink: 0; z-index: 10; }
.tab { flex: 1; padding: 11px 0; background: none; border: none; color: var(--muted); font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .07em; cursor: pointer; text-transform: uppercase; position: relative; transition: color .2s; }
.tab.active { color: var(--text); }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 18%; right: 18%; height: 2px; background: var(--red); border-radius: 2px; }

/* ── Filters ── */
#filters { display: flex; gap: 8px; padding: 10px 20px; overflow-x: auto; background: var(--dark); flex-shrink: 0; }
#filters::-webkit-scrollbar { height: 0; }
.pill { padding: 6px 14px; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all .2s; }
.pill.active { background: var(--red); border-color: var(--red); color: #fff; }

/* ── Map ── */
#map-panel { position: relative; flex: 1; }
#gmap { width: 100%; height: 100%; }
#map-legend { position: absolute; bottom: 14px; left: 14px; background: rgba(7,11,20,.93); border: 1px solid var(--border); border-radius: 12px; padding: 10px 13px; font-size: 10px; font-family: 'Space Mono', monospace; z-index: 5; }
.legend-row { display: flex; align-items: center; gap: 7px; margin-bottom: 3px; color: var(--muted); }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* ── List ── */
.list-item { display: flex; align-items: center; gap: 13px; padding: 13px 20px; cursor: pointer; border-bottom: 1px solid rgba(255,255,255,.04); transition: background .15s; }
.list-item:hover, .list-item:active { background: rgba(255,36,66,.07); }
.list-rank { font-size: 10px; color: #475569; width: 20px; flex-shrink: 0; font-family: 'Space Mono', monospace; }
.list-icon { width: 47px; height: 47px; border-radius: 13px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 22px; }
.list-info { flex: 1; min-width: 0; }
.list-name { font-weight: 700; font-size: 14px; }
.list-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
.list-bar-track { height: 4px; border-radius: 2px; background: #0f172a; margin-top: 6px; overflow: hidden; }
.list-bar-fill { height: 100%; border-radius: 2px; transition: width .8s ease; }
.list-score { text-align: right; flex-shrink: 0; }
.list-score-num { font-size: 21px; font-weight: 800; font-family: 'Space Mono', monospace; }
.list-score-lbl { font-size: 11px; font-weight: 700; margin-top: 1px; }

/* ── Trending ── */
.feed-item { background: #0f172a; border: 1px solid var(--border); border-radius: 13px; padding: 12px 15px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
.feed-text { font-size: 13px; font-weight: 600; flex: 1; padding-right: 10px; }
.feed-time { font-size: 10px; color: #475569; font-family: 'Space Mono', monospace; flex-shrink: 0; }
.leader-row { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-bottom: 1px solid #0f172a; cursor: pointer; }
.leader-medal { font-size: 16px; width: 28px; text-align: center; }
.leader-emoji { font-size: 22px; }
.leader-info { flex: 1; }
.leader-name { font-weight: 700; font-size: 14px; }
.leader-sub { font-size: 11px; color: var(--muted); }
.leader-score { font-size: 22px; font-weight: 800; font-family: 'Space Mono', monospace; }

/* ── Venue Sheet ── */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.68); z-index: 100; display: flex; align-items: flex-end; justify-content: center; }
.sheet { width: 100%; max-width: 430px; background: linear-gradient(180deg, #0d1429, var(--dark)); border-top-left-radius: 24px; border-top-right-radius: 24px; border: 1px solid var(--border); max-height: 88vh; overflow-y: auto; box-shadow: 0 -30px 80px rgba(0,0,0,.95); animation: slideUp .35s cubic-bezier(.16,1,.3,1) both; }
.sheet::-webkit-scrollbar { width: 0; }
.drag-handle { width: 40px; height: 4px; border-radius: 2px; background: #334155; margin: 0 auto 20px; }
.sheet-hero { padding: 20px 22px 16px; border-bottom: 1px solid var(--border); }
.sheet-icon { width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 34px; flex-shrink: 0; }
.sheet-title { font-size: 20px; font-weight: 800; letter-spacing: -.02em; }
.sheet-vibe { font-weight: 700; font-size: 14px; margin-top: 3px; }
.tag { font-size: 10px; font-weight: 600; padding: 3px 8px; background: var(--border); border-radius: 6px; color: #94a3b8; }
.sub-tabs { display: flex; border-bottom: 1px solid #0f172a; }
.sub-tab { flex: 1; padding: 11px 0; background: none; border: none; color: #475569; font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700; cursor: pointer; text-transform: uppercase; letter-spacing: .06em; border-bottom: 2px solid transparent; transition: all .2s; }
.sub-tab.active { color: var(--text); border-bottom-color: var(--red); }
.sheet-body { padding: 18px 22px; }
.stat-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 18px; }
.stat-box { background: #0f172a; border-radius: 12px; padding: 12px 0; text-align: center; border: 1px solid var(--border); }
.stat-val { font-size: 19px; font-weight: 800; font-family: 'Space Mono', monospace; }
.stat-lbl { font-size: 9px; color: #475569; letter-spacing: .12em; margin-top: 2px; }
.info-row { display: flex; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid #0f172a; }
.info-label { font-size: 13px; color: var(--muted); }
.info-val { font-size: 13px; font-weight: 600; }
.meter-track { height: 9px; border-radius: 5px; background: #0f172a; overflow: hidden; }
.meter-fill { height: 100%; border-radius: 5px; transition: width .8s ease; }
.rating-bar { margin-bottom: 10px; }
.rating-label-row { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 12px; }
.rating-bar-track { height: 6px; border-radius: 3px; background: #0f172a; overflow: hidden; }
.rating-bar-fill { height: 100%; border-radius: 3px; transition: width .6s ease; }
.vip-card { border-radius: 16px; padding: 22px 18px; text-align: center; margin-bottom: 14px; border: 1px solid rgba(255,215,0,.2); background: linear-gradient(135deg,#1a0a0f,#0f172a); }
.btn-primary { width: 100%; padding: 14px 0; border-radius: 14px; background: linear-gradient(135deg,var(--red),#FF6B00); border: none; color: #fff; font-family: 'Syne', sans-serif; font-weight: 800; font-size: 14px; cursor: pointer; box-shadow: 0 4px 20px rgba(255,36,66,.35); transition: all .2s; }
.btn-primary:active { transform: scale(.97); }
.btn-secondary { padding: 14px 0; border-radius: 14px; background: var(--border); border: 1px solid #334155; color: #94a3b8; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; cursor: pointer; transition: all .2s; }
.btn-row { display: flex; gap: 10px; padding: 0 22px 10px; }

/* ── Check-in Modal ── */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.8); z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
.modal { width: 100%; max-width: 430px; background: var(--card); border-top-left-radius: 24px; border-top-right-radius: 24px; padding: 24px 22px 52px; border: 1px solid var(--border); animation: slideUp .35s cubic-bezier(.16,1,.3,1) both; }
.slider-label-row { display: flex; justify-content: space-between; margin-bottom: 7px; font-size: 13px; }
input[type=range] { width: 100%; height: 5px; accent-color: var(--red); cursor: pointer; margin-bottom: 18px; }

/* ── Toast ── */
#toast { position: fixed; bottom: 88px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--border); border: 1px solid #334155; border-radius: 20px; padding: 10px 22px; font-size: 13px; font-weight: 700; z-index: 999; white-space: nowrap; box-shadow: 0 8px 32px rgba(0,0,0,.5); opacity: 0; transition: all .3s; pointer-events: none; }
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── Section title ── */
.section-title { font-size: 10px; color: var(--muted); font-family: 'Space Mono', monospace; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 13px; }

/* ── Animations ── */
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.2} }
@keyframes slideUp { from{transform:translateY(100%);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
@keyframes pulseRing { 0%{transform:scale(1);opacity:.8} 100%{transform:scale(1.7);opacity:0} }

/* ── Loading ── */
#loading { position: fixed; inset: 0; background: var(--dark); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 9999; gap: 16px; }
.spinner { width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--red); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Search */
.search-input { width: 100%; padding: 11px 16px; border-radius: 12px; background: #0f172a; border: 1px solid var(--border); color: var(--text); font-family: 'Syne', sans-serif; font-size: 14px; outline: none; margin-bottom: 12px; }

