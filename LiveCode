async function submitCheckin(id) {
  const busy   = +document.getElementById('busy-slider').value;
  const energy = +document.getElementById('energy-slider').value;
  const music  = +document.getElementById('music-slider').value;

  // Update local state immediately so UI responds fast
  const v = venues.find(x => x.id === id);
  if (v) {
    v.heat          = Math.min(99, v.heat + 3);
    v.checkin_count = (v.checkin_count || 0) + 1;
    v.energy_rating = +(v.energy_rating * 0.75 + energy * 0.25).toFixed(1);
    v.music_rating  = +(v.music_rating  * 0.75 + music  * 0.25).toFixed(1);
    v.crowd_rating  = +(v.crowd_rating  * 0.75 + busy   * 0.25).toFixed(1);
    v.vibe_label    = v.heat >= 81 ? 'Packed' : v.heat >= 61 ? 'Busy' : v.heat >= 41 ? 'Moderate' : v.heat >= 21 ? 'Chill' : 'Dead';
  }

  // Save to Supabase if available
  if (sb) {
    try {
      await sb.from('checkins').insert({ venue_id: id, busy_rating: busy, energy_rating: energy, music_rating: music });
      if (v) {
        await sb.from('venues').update({
          heat: v.heat, checkin_count: v.checkin_count,
          energy_rating: v.energy_rating, music_rating: v.music_rating,
          crowd_rating: v.crowd_rating, vibe_label: v.vibe_label,
        }).eq('id', id);
      }
    } catch(e) { console.warn('Checkin save failed:', e); }
  }

  checkedInId = id;
  document.getElementById('checkin-content').innerHTML = `
    <div style="text-align:center;padding:24px 0">
      <div style="font-size:52px">✅</div>
      <div style="font-size:20px;font-weight:800;margin-top:14px">Checked In!</div>
      <div style="color:var(--muted);font-size:13px;margin-top:6px">Vibe score updated in real-time</div>
    </div>
  `;
  setTimeout(() => {
    document.getElementById('checkin-modal').style.display = 'none';
    showToast('🔥 Check-in live! Map updated.');
    if (selectedId === id) { const v2 = venues.find(x=>x.id===id); if(v2) renderSheet(v2); }
  }, 1500);
}

function closeModalOnOverlay(e, id) {
  if (e.target === e.currentTarget) document.getElementById(id).style.display = 'none';
}

// ── NIGHT PLANNER ─────────────────────────────────────────────────────────────
function openPlanner() {
  const topType = (t) => [...venues].filter(v=>v.type===t).sort((a,b)=>b.heat-a.heat)[0];
  const stops = [
    { time:'7:00 PM',  label:'Dinner',       icon:'🍽', v: topType('restaurant') },
    { time:'9:30 PM',  label:'Cocktail Bar', icon:'🍸', v: topType('bar') },
    { time:'11:30 PM', label:'Club',         icon:'🎵', v: topType('club') },
  ];
  const stopsHTML = stops.map((s,i) => {
    const c = s.v ? heatColor(s.v.heat) : null;
    return `
      <div style="display:flex;gap:14px;margin-bottom:18px;align-items:flex-start">
        <div style="display:flex;flex-direction:column;align-items:center;padding-top:4px">
          <div style="width:13px;height:13px;border-radius:50%;background:${c?.bg||'#334155'};box-shadow:${c?`0 0 8px ${c.glow}`:'none'};flex-shrink:0"></div>
          ${i<stops.length-1?'<div style="width:2px;height:42px;background:linear-gradient(#334155,transparent);margin-top:4px"></div>':''}
        </div>
        <div style="flex:1;background:#0f172a;border-radius:14px;padding:13px 15px;border:1px solid var(--border)">
          <div style="display:flex;justify-content:space-between;margin-bottom:5px">
            <span style="font-size:11px;color:#475569;font-family:monospace">${s.time}</span>
            <span style="font-size:11px;color:var(--muted);font-weight:600;background:var(--border);border-radius:6px;padding:2px 8px">${s.icon} ${s.label}</span>
          </div>
          ${s.v
            ? `<div style="font-weight:700;font-size:16px">${s.v.name}</div>
               <div style="font-size:12px;color:${c.bg};margin-top:3px;font-weight:600">${c.emoji} ${s.v.vibe_label} · Vibe ${s.v.heat}</div>`
            : `<div style="color:#475569;font-size:13px">No venue found</div>`
          }
        </div>
      </div>`;
  }).join('');

  document.getElementById('planner-content').innerHTML = `
    <div style="font-size:21px;font-weight:800;margin-bottom:4px">🌙 Night Planner</div>
    <div style="font-size:12px;color:var(--muted);margin-bottom:22px">Your perfect Orlando night out — based on live vibes</div>
    ${stopsHTML}
    <button class="btn-primary" onclick="savePlan()">Save My Night Plan</button>
  `;
  document.getElementById('planner-modal').style.display = 'flex';
}

function savePlan() {
  document.getElementById('planner-modal').style.display = 'none';
  switchTab('map');
  showToast('🌙 Night plan saved!');
}

// ── SHARE ─────────────────────────────────────────────────────────────────────
function shareVibe(name, heat) {
  const c = heatColor(heat);
  const text = `${c.emoji} ${name} is ${c.label} right now (${heat}/100 vibe score)! Check the live map 🗺 #LiveVibeMap #Orlando`;
  if (navigator.share) {
    navigator.share({ title:'Live Vibe Map', text });
  } else {
    navigator.clipboard.writeText(text).then(() => showToast('📋 Vibe copied to clipboard!'));
  }
}

// ── TOAST ─────────────────────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2600);
}

// ── START ─────────────────────────────────────────────────────────────────────
init();
</script>
